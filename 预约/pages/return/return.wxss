.container {
    background-color: #f5f5f5;
    min-height: 100vh;
    padding: 20rpx;
}

.section,.section-title {
    margin-bottom: 20rpx;
}

.section-title {
    color: #333;
    font-size: 32rpx;
    font-weight: 700;
}

.reservation-list {
    width: 100%;
}

.reservation-item {
    background: #fff;
    border-radius: 12rpx;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,.1);
    margin-bottom: 20rpx;
    padding: 30rpx;
}

.reservation-header {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    justify-content: space-between;
    margin-bottom: 20rpx;
}

.status-tag {
    border-radius: 30rpx;
    color: #fff;
    font-size: 24rpx;
    padding: 6rpx 20rpx;
}

.status-pending {
    background-color: #ffa940;
}

.status-approved {
    background-color: #52c41a;
}

.status-rejected {
    background-color: #ff4d4f;
}

.status-using {
    background-color: #1890ff;
}

.status-returned {
    background-color: #8c8c8c;
}

.status-cancelled {
    background-color: #d9d9d9;
}

.time-text {
    color: #666;
    font-size: 28rpx;
}

.reservation-content,.time-section {
    margin-bottom: 20rpx;
}

.time-row {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    margin-bottom: 10rpx;
}

.time-row:last-child {
    margin-bottom: 0;
}

.label {
    color: #666;
    margin-right: 20rpx;
    min-width: 140rpx;
}

.label,.value {
    font-size: 28rpx;
}

.value {
    color: #333;
}

.items-section {
    background: #f9f9f9;
    border-radius: 8rpx;
    padding: 20rpx;
}

.section-row {
    background: #fff;
    border-radius: 8rpx;
    margin-bottom: 16rpx;
    padding: 16rpx;
}

.section-row:last-child {
    margin-bottom: 0;
}

.items-title {
    color: #666;
    display: block;
    font-size: 28rpx;
    margin-bottom: 16rpx;
}

.reserved-items {
    flex-wrap: wrap;
    gap: 16rpx;
}

.item-tag,.reserved-items {
    display: -webkit-flex;
    display: flex;
}

.item-tag {
    align-items: center;
    background: #f8f8f8;
    border-radius: 6rpx;
    gap: 10rpx;
    padding: 12rpx 20rpx;
}

.item-category {
    background: #f0f0f0;
    border-radius: 4rpx;
    color: #666;
    font-size: 24rpx;
    padding: 4rpx 12rpx;
}

.item-name {
    color: #333;
    font-size: 28rpx;
}

.action-bar {
    display: -webkit-flex;
    display: flex;
    flex-wrap: wrap;
    gap: 20rpx;
    justify-content: flex-end;
    margin-top: 20rpx;
}

.action-btn {
    border-radius: 8rpx;
    flex: 0 0 auto;
    font-size: 28rpx;
    margin: 0;
    min-width: 180rpx;
    padding: 16rpx 32rpx;
    text-align: center;
}

.start-btn {
    background-color: #1890ff;
    color: #fff;
}

.return-btn {
    background-color: #52c41a;
    color: #fff;
}

.cancel-btn {
    background-color: #ff4d4f;
    color: #fff;
}

.empty-tip,.loading-tip {
    color: #999;
    font-size: 28rpx;
    padding: 40rpx;
    text-align: center;
}

.purpose-section {
    border-top: 2rpx solid #f0f0f0;
    margin-top: 24rpx;
    padding-top: 24rpx;
}

.purpose-title {
    color: #666;
    display: block;
    font-size: 28rpx;
    margin-bottom: 12rpx;
}

.purpose-content {
    background: #f8f8f8;
    border-radius: 8rpx;
    color: #333;
    display: block;
    font-size: 28rpx;
    line-height: 1.5;
    padding: 16rpx;
    white-space: pre-wrap;
    word-break: break-all;
}


