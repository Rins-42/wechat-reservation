.page-container {
    background: #f8f8f8;
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
    height: 100vh;
}

.fixed-header {
    background: #f8f8f8;
    padding: 20rpx 20rpx 0;
    z-index: 100;
}

.main-content {
    box-sizing: border-box;
    flex: 1;
    overflow: hidden;
    padding: 30rpx 30rpx 120rpx;
}

.fixed-bottom {
    background: #fff;
    bottom: 0;
    box-shadow: 0 -2rpx 10rpx rgba(0,0,0,.05);
    left: 0;
    padding: 20rpx 30rpx;
    position: fixed;
    right: 0;
    z-index: 100;
}

.bottom-space {
    height: 120rpx;
}

.container {
    background: #f8f8f8;
    min-height: 100vh;
    padding: 30rpx;
}

.section {
    background: #fff;
    border-radius: 12rpx;
    margin-bottom: 30rpx;
    padding: 30rpx;
}

.section-title {
    align-items: center;
    color: #333;
    display: -webkit-flex;
    display: flex;
    font-size: 28rpx;
    margin-bottom: 12rpx;
}

.items-list {
    padding: 0;
}

.item {
    background: #fff;
    border: 2rpx solid #f5f5f5;
    border-radius: 12rpx;
    margin-bottom: 20rpx;
    padding: 24rpx;
    position: relative;
    transition: all .3s ease;
}

.item.selected {
    background: rgba(0,122,255,.08);
    border-color: #007aff;
}

.item-info {
    position: relative;
}

.item-header {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    justify-content: space-between;
    margin-bottom: 12rpx;
}

.item-category {
    background: rgba(0,122,255,.1);
    color: #007aff;
    font-size: 24rpx;
}

.approval-tag,.item-category {
    border-radius: 4rpx;
    padding: 4rpx 12rpx;
}

.approval-tag {
    background: rgba(255,152,0,.1);
    color: #ff9800;
    font-size: 22rpx;
    margin-left: 12rpx;
}

.item-name {
    color: #333;
    display: block;
    font-size: 28rpx;
    font-weight: 500;
    margin-bottom: 8rpx;
}

.item-desc {
    color: #666;
    display: block;
    font-size: 24rpx;
}

.select-status {
    align-items: center;
    background: #007aff;
    border-radius: 50%;
    display: -webkit-flex;
    display: flex;
    height: 40rpx;
    justify-content: center;
    position: absolute;
    right: 24rpx;
    top: 24rpx;
    width: 40rpx;
}

.select-icon,.select-text {
    color: #fff;
    font-size: 24rpx;
}

.item::after {
    background-color: initial;
    border: 2rpx solid transparent;
    border-radius: 12rpx;
    bottom: 0;
    content: "";
    left: 0;
    pointer-events: none;
    position: absolute;
    right: 0;
    top: 0;
    transition: all .3s cubic-bezier(.4,0,.2,1);
}

.item.selected::after {
    background-color: rgba(0,122,255,.08);
    border-color: #007aff;
    box-shadow: 0 2rpx 12rpx rgba(0,122,255,.15);
}

.item-checkbox {
    height: 44rpx;
    width: 44rpx;
}

.checkbox,.item-checkbox {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    flex-shrink: 0;
    justify-content: center;
}

.checkbox {
    background: #fff;
    border: 2rpx solid #ddd;
    border-radius: 50%;
    color: transparent;
    font-size: 28rpx;
    font-weight: 700;
    height: 40rpx;
    margin-top: 4rpx;
    width: 40rpx;
}

.checkbox.checked {
    background: #007aff;
    border-color: #007aff;
    color: #fff;
}

.check-mark {
    color: #fff;
    font-size: 28rpx;
    font-weight: 700;
}

.time-section {
    background: #f8f8f8;
    border-radius: 8rpx;
    padding: 24rpx;
}

.time-row {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    margin-bottom: 20rpx;
}

.time-row:last-child {
    margin-bottom: 0;
}

.time-label {
    flex-shrink: 0;
    width: 140rpx;
}

.picker,.time-label {
    color: #333;
    font-size: 28rpx;
}

.picker {
    background: #fff;
    border-radius: 6rpx;
    flex: 1;
    padding: 20rpx;
    text-align: center;
}

.tips {
    margin-bottom: 30rpx;
    padding: 0 30rpx;
}

.tip-text {
    color: #999;
    display: block;
    font-size: 24rpx;
    margin-bottom: 8rpx;
}

.submit-btn {
    background: #007aff;
    border-radius: 8rpx;
    color: #fff;
    font-size: 32rpx;
    height: 88rpx;
    line-height: 88rpx;
    margin-top: 40rpx;
    text-align: center;
    width: 100%;
}

.submit-btn[disabled] {
    background: #ccc;
    opacity: .6;
}

.selected-summary {
    background: #f8f8f8;
    border-radius: 8rpx;
    max-height: 240rpx;
    overflow-y: auto;
    padding: 12rpx;
}

.selected-count {
    color: #666;
    font-size: 24rpx;
    font-weight: 400;
    margin-left: 8rpx;
}

.selected-item {
    align-items: center;
    background: #fff;
    border-radius: 6rpx;
    display: -webkit-flex;
    display: flex;
    justify-content: space-between;
    margin-bottom: 12rpx;
    min-height: 48rpx;
    padding: 12rpx;
}

.selected-item:last-child {
    margin-bottom: 0;
}

.selected-item-info {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    flex: 1;
    gap: 8rpx;
    margin-right: 12rpx;
}

.selected-item-name {
    color: #333;
    font-size: 26rpx;
}

.selected-item-category {
    background: rgba(0,122,255,.1);
    border-radius: 4rpx;
    color: #007aff;
    font-size: 22rpx;
    padding: 2rpx 8rpx;
}

.selected-item-action {
    flex-shrink: 0;
}

.remove-btn {
    align-items: center;
    background: #f5f5f5;
    border-radius: 50%;
    color: #999;
    display: -webkit-flex;
    display: flex;
    font-size: 28rpx;
    height: 36rpx;
    justify-content: center;
    width: 36rpx;
}

.category-list {
    padding: 20rpx 0;
    white-space: nowrap;
}

.category-item {
    background: #f5f5f5;
    border-radius: 8rpx;
    color: #666;
    display: inline-block;
    font-size: 28rpx;
    margin-right: 16rpx;
    padding: 12rpx 24rpx;
    transition: all .3s;
}

.category-item.active {
    background: #007aff;
    color: #fff;
}

.empty-tip {
    background: #f8f8f8;
    border-radius: 8rpx;
    color: #999;
    font-size: 28rpx;
    padding: 40rpx 0;
    text-align: center;
}

.sub-tip {
    display: block;
    margin-top: 8rpx;
}

.loading-tip,.sub-tip {
    color: #999;
    font-size: 24rpx;
}

.loading-tip {
    padding: 20rpx 0;
    text-align: center;
}

.empty-state {
    align-items: center;
    background: #fff;
    border-radius: 8rpx;
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60rpx 0;
}

.empty-icon {
    height: 200rpx;
    margin-bottom: 20rpx;
    width: 200rpx;
}

.empty-text {
    color: #666;
    font-size: 28rpx;
    margin-bottom: 8rpx;
}

.empty-subtext {
    color: #999;
    font-size: 24rpx;
}

.loading-state {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 40rpx 0;
}

.loading-icon {
    animation: spin 1s linear infinite;
    border: 4rpx solid #f3f3f3;
    border-radius: 50%;
    border-top-color: #007aff;
    height: 40rpx;
    margin-bottom: 16rpx;
    width: 40rpx;
}

.loading-text {
    color: #999;
    font-size: 24rpx;
}

@-webkit-keyframes spin {
0% {
    transform: rotate(0deg);
}

100% {
    transform: rotate(1turn);
}

}
@keyframes spin {
0% {
    transform: rotate(0deg);
}

100% {
    transform: rotate(1turn);
}

}
.reservation-list {
    background: #fff;
    border-radius: 12rpx;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05);
    margin-top: 30rpx;
    padding: 20rpx;
}

.reservation-list-title {
    border-bottom: 1rpx solid #f0f0f0;
    color: #333;
    font-size: 28rpx;
    font-weight: 700;
    padding: 20rpx;
}

.reservation-list-content {
    padding: 20rpx 0;
}

.date-group {
    margin-bottom: 30rpx;
}

.date-group:last-child {
    margin-bottom: 0;
}

.date-header {
    background: #f8f8f8;
    border-radius: 6rpx;
    color: #666;
    font-size: 26rpx;
}

.date-header,.time-slots {
    padding: 10rpx 20rpx;
}

.time-slot {
    align-items: flex-start;
    border-bottom: 1rpx solid #f5f5f5;
    display: -webkit-flex;
    display: flex;
    padding: 16rpx 0;
}

.time-slot:last-child {
    border-bottom: none;
}

.time-slot-time {
    color: #333;
    font-size: 26rpx;
    min-width: 200rpx;
}

.time-slot-items {
    display: -webkit-flex;
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    gap: 10rpx;
}

.time-slot-user {
    color: #666;
    font-size: 24rpx;
    margin-left: 20rpx;
    min-width: 120rpx;
}

.item-tag {
    background: rgba(0,122,255,.1);
    border-radius: 4rpx;
    color: #007aff;
    font-size: 24rpx;
    padding: 4rpx 12rpx;
}

.purpose-row {
    align-items: flex-start;
    border-top: 2rpx solid #e8e8e8;
    display: -webkit-flex;
    display: flex;
    margin-top: 30rpx;
    padding-top: 30rpx;
}

.purpose-input-wrapper {
    background: #fff;
    border-radius: 6rpx;
    flex: 1;
    padding: 16rpx;
}

.purpose-input {
    background: #fff;
    border: 2rpx solid #e8e8e8;
    border-radius: 8rpx;
    box-sizing: border-box;
    font-size: 28rpx;
    height: 180rpx;
    line-height: 1.5;
    padding: 16rpx;
    width: 100%;
}

.word-count {
    color: #999;
    font-size: 24rpx;
    margin-top: 8rpx;
    padding-right: 8rpx;
    text-align: right;
}


