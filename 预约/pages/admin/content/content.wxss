.container {
    background: #f8f8f8;
    box-sizing: border-box;
    min-height: 100vh;
    padding: 30rpx 30rpx 180rpx;
}

.form-group {
    background: #fff;
    border-radius: 12rpx;
    margin-bottom: 30rpx;
    padding: 30rpx;
}

.form-row {
    display: -webkit-flex;
    display: flex;
    gap: 30rpx;
    margin-bottom: 30rpx;
}

.form-col {
    flex: 1;
    min-width: 0;
}

.form-item {
    margin-bottom: 30rpx;
}

.description-area,.form-item:last-child {
    margin-bottom: 0;
}

.label {
    color: #333;
    display: block;
    font-size: 28rpx;
    font-weight: 500;
    margin-bottom: 16rpx;
}

.input {
    height: 88rpx;
    padding: 0 24rpx;
}

.input,.textarea {
    background: #f8f8f8;
    border-radius: 8rpx;
    box-sizing: border-box;
    font-size: 28rpx;
    width: 100%;
}

.textarea {
    height: 160rpx;
    padding: 24rpx;
}

.picker {
    background: #f8f8f8;
    border-radius: 8rpx;
    width: 100%;
}

.picker-inner {
    color: #333;
    font-size: 28rpx;
    height: 88rpx;
    line-height: 88rpx;
    padding: 0 24rpx;
}

.settings-container {
    background: #f8f8f8;
    border-radius: 8rpx;
    padding: 20rpx;
}

.setting-item {
    align-items: center;
    background: #fff;
    border-radius: 6rpx;
    display: -webkit-flex;
    display: flex;
    justify-content: space-between;
    margin-bottom: 16rpx;
    padding: 16rpx;
}

.setting-item:last-child {
    margin-bottom: 0;
}

.setting-label {
    color: #333;
    font-size: 28rpx;
}

.number-input {
    background: #f8f8f8;
    border-radius: 6rpx;
    font-size: 28rpx;
    height: 60rpx;
    padding: 0 16rpx;
    text-align: right;
    width: 160rpx;
}

.form-actions {
    background: #fff;
    border-radius: 12rpx;
    bottom: 30rpx;
    box-shadow: 0 -2rpx 10rpx rgba(0,0,0,.05);
    left: 30rpx;
    padding: 20rpx;
    position: fixed;
    right: 30rpx;
}

.submit-btn {
    background: #007aff;
    border-radius: 8rpx;
    color: #fff;
    font-size: 32rpx;
    height: 88rpx;
    line-height: 88rpx;
    text-align: center;
    width: 100%;
}


