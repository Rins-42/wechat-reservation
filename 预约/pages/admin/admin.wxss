.container {
    background: #f8f8f8;
    flex-direction: column;
    min-height: 100vh;
}

.container,.tabs {
    display: -webkit-flex;
    display: flex;
}

.tabs {
    background: #fff;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,.05);
    margin-bottom: 30rpx;
    padding: 20rpx 30rpx;
    position: -webkit-sticky;
    position: sticky;
    top: 0;
    z-index: 100;
}

.tab {
    color: #666;
    flex: 1;
    font-size: 28rpx;
    padding: 20rpx 0;
    position: relative;
    text-align: center;
    transition: all .3s;
}

.tab.active {
    color: #007aff;
    font-weight: 700;
}

.tab.active:after {
    background: #007aff;
    border-radius: 2rpx;
    bottom: 0;
    content: "";
    height: 4rpx;
    left: 50%;
    position: absolute;
    transform: translateX(-50%);
    width: 40rpx;
}

.content {
    background: #fff;
    border-radius: 12rpx;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,.05);
    box-sizing: border-box;
    flex: 1;
    height: calc(100vh - 180rpx);
    margin: 0 30rpx 30rpx;
    padding: 30rpx;
}

.add-section {
    background: #f8f8f8;
    border-radius: 12rpx;
    flex-shrink: 0;
    margin-bottom: 30rpx;
    padding: 24rpx;
}

.form-item {
    margin-bottom: 24rpx;
}

.form-item:last-child {
    margin-bottom: 0;
}

.label {
    color: #333;
    display: block;
    font-weight: 500;
    margin-bottom: 12rpx;
}

.input,.label {
    font-size: 28rpx;
}

.input {
    background: #fff;
    border: 2rpx solid #e8e8e8;
    border-radius: 8rpx;
    box-sizing: border-box;
    padding: 24rpx;
    width: 100%;
}

.input:focus {
    border-color: #007aff;
}

.picker {
    background: #fff;
    border: 2rpx solid #e8e8e8;
    border-radius: 8rpx;
    box-sizing: border-box;
    color: #333;
    font-size: 28rpx;
    padding: 24rpx;
    position: relative;
    width: 100%;
}

.picker-empty {
    color: #999;
}

.add-btn {
    background: #007aff;
    border: none;
    border-radius: 8rpx;
    color: #fff;
    font-size: 32rpx;
    margin-top: 30rpx;
    padding: 24rpx 0;
    text-align: center;
    width: 100%;
}

.add-btn[disabled] {
    background: #ccc;
    opacity: .6;
}

.list {
    background: #f8f8f8;
    flex: 1;
    min-height: 200rpx;
    overflow-y: auto;
    padding: 20rpx;
}

.list,.list-item {
    border-radius: 12rpx;
}

.list-item {
    background: #fff;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05);
    display: -webkit-flex;
    display: flex;
    margin-bottom: 20rpx;
    transition: all .3s ease;
}

.list-item.selected {
    background: #f0f7ff;
    border: 2rpx solid #007aff;
}

.list-item:last-child {
    margin-bottom: 0;
}

.item-select {
    align-items: flex-start;
    padding: 30rpx 20rpx;
}

.item-content {
    flex: 1;
    overflow: hidden;
    padding: 24rpx 24rpx 24rpx 0;
}

.item-header {
    align-items: flex-start;
    margin-bottom: 16rpx;
}

.item-title {
    flex: 1;
    margin-right: 20rpx;
}

.item-category {
    display: inline-block;
    font-size: 24rpx;
    margin-right: 12rpx;
    padding: 4rpx 12rpx;
}

.item-name {
    font-size: 32rpx;
    font-weight: 500;
}

.item-desc {
    color: #666;
    font-size: 28rpx;
    line-height: 1.5;
    margin-bottom: 16rpx;
}

.item-settings {
    flex-wrap: wrap;
}

.setting-tag {
    align-items: center;
    border-radius: 6rpx;
    display: -webkit-inline-flex;
    display: inline-flex;
    padding: 6rpx 12rpx;
}

.setting-tag.active {
    background: #e8f5e9;
    color: #4caf50;
}

.setting-tag.time {
    color: #999;
}

.tag-icon {
    font-size: 26rpx;
    margin-right: 6rpx;
}

.item-actions {
    display: -webkit-flex;
    display: flex;
    gap: 16rpx;
}

.action-btn {
    border-radius: 24rpx;
    box-shadow: 0 1rpx 3rpx rgba(0,0,0,.1);
    font-weight: 400;
    height: 48rpx;
    padding: 0;
    width: 48rpx;
}

.action-btn.edit {
    background: linear-gradient(135deg,#1989fa,#007aff);
    color: #fff;
}

.action-btn.edit:active {
    background: linear-gradient(135deg,#0e5aa0,#0056b3);
    transform: translateY(2rpx);
}

.action-btn.delete {
    background: linear-gradient(135deg,#ff6b6b,#ff3b30);
    color: #fff;
}

.action-btn.delete:active {
    background: linear-gradient(135deg,#d14747,#cc2f26);
    transform: translateY(2rpx);
}

.tab-content {
    display: -webkit-flex;
    display: flex;
    flex: 1;
    flex-direction: column;
    height: 100%;
    position: relative;
}

.content-scroll {
    padding-bottom: 120rpx;
}

.batch-actions {
    bottom: 0;
    box-shadow: 0 -2rpx 10rpx rgba(0,0,0,.05);
    left: 0;
    padding: 20rpx 30rpx;
    position: fixed;
    right: 0;
    transform: translateY(100%);
    transition: -webkit-transform .3s ease;
    transition: transform .3s ease;
    transition: transform .3s ease,-webkit-transform .3s ease;
    z-index: 100;
}

.batch-actions.visible {
    transform: translateY(0);
}

.selected-count {
    color: #333;
    font-weight: 500;
}

.batch-btn {
    align-items: center;
    border: none;
    color: #666;
    display: -webkit-inline-flex;
    display: inline-flex;
    justify-content: center;
    padding: 16rpx 32rpx;
    transition: all .3s ease;
}

.batch-btn.delete {
    background: rgba(255,59,48,.1);
}

.batch-btn:active {
    opacity: .8;
    transform: translateY(2rpx);
}

.empty-tip {
    align-items: center;
    color: #999;
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
    gap: 20rpx;
    padding: 60rpx 0;
    text-align: center;
}

.empty-icon {
    height: 200rpx;
    opacity: .5;
    width: 200rpx;
}

.loading-tip {
    align-items: center;
    color: #999;
    display: -webkit-flex;
    display: flex;
    font-size: 24rpx;
    gap: 12rpx;
    justify-content: center;
    padding: 20rpx 0;
    text-align: center;
}

.loading-spinner {
    animation: spin 1s linear infinite;
    border: 4rpx solid #f3f3f3;
    border-radius: 50%;
    border-top-color: #007aff;
    height: 32rpx;
    width: 32rpx;
}

.divider {
    color: #ddd;
    margin: 0 12rpx;
}

@-webkit-keyframes spin {
0% {
    transform: rotate(0deg);
}

100% {
    transform: rotate(1turn);
}

}
@keyframes spin {
0% {
    transform: rotate(0deg);
}

100% {
    transform: rotate(1turn);
}

}
.reservation-list {
