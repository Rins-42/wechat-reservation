.container {
    background: #f8f8f8;
    min-height: 100vh;
    padding: 30rpx;
}

.form-section {
    background: #fff;
    border-radius: 12rpx;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05);
    padding: 30rpx;
}

.form-title {
    color: #333;
    font-size: 32rpx;
    font-weight: 700;
    margin-bottom: 16rpx;
}

.form-desc {
    color: #666;
    font-size: 26rpx;
    margin-bottom: 30rpx;
}

.form-item {
    margin-bottom: 24rpx;
}

.label {
    color: #333;
    display: block;
    font-size: 28rpx;
    margin-bottom: 12rpx;
}

.input {
    background: #f8f8f8;
    box-sizing: border-box;
    font-size: 28rpx;
    padding: 0 24rpx;
}

.input,.submit-btn {
    border-radius: 8rpx;
    height: 88rpx;
    width: 100%;
}

.submit-btn {
    align-items: center;
    background: #007aff;
    color: #fff;
    display: -webkit-flex;
    display: flex;
    font-size: 30rpx;
    justify-content: center;
    margin-top: 40rpx;
}

.submit-btn[disabled] {
    background: #ccc;
    color: #fff;
}


